# Copy to ~/.hybrid-lab.env (outside the repo), fill in real values, chmod 600.
# Every value below is a placeholder. RFC 5737 documentation ranges are used
# for public addresses. Secrets (PSKs) are NOT stored here: they live in
# Google Secret Manager and are read on demand.

# ---- Google Cloud ----
export PROJECT_ID="your-project-id"
export REGION="us-west1"
export ZONE="us-west1-b"
export TF_STATE_BUCKET="your-project-id-tfstate"

# ---- On-premises public addresses (one per router) ----
export OPNSENSE_WAN_IP="203.0.113.13"
export VYOS_WAN_IP="203.0.113.14"
export ISP_GATEWAY_IP="203.0.113.9"

# ---- Lab networks ----
export OPNSENSE_LAN="10.2.10.0/24"
export VYOS_LAN="10.2.20.0/24"
export GCP_HUB_SUBNET="10.8.10.0/24"

# ---- Filled in later, after the HA VPN gateway exists (read from gcloud) ----
export GCP_VPN_IP0="198.51.100.10"
export GCP_VPN_IP1="198.51.100.20"
